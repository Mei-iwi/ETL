# CẤU HÌNH ETL — phân nhóm theo chức năng.
# File .env chứa thông tin riêng: giữ local, không commit. Dùng .env.example làm mẫu.

# 1. VẬN HÀNH API
# Vai trò: Điều khiển log, quyền API quản trị và giới hạn dung lượng request upload.
# ADMIN_ENABLED chỉ bật trong môi trường local được kiểm soát; không thay thế xác thực admin.
LOG_LEVEL=INFO
ADMIN_ENABLED=false
UPLOAD_REQUEST_MAX_BYTES=525336576

# Đăng nhập local qua Vite (3000); điền email/đường dẫn secret theo README trước khi start.
APP_ENVIRONMENT=development
AUTH_MODE=single_admin
# Opt-in sau provision/migration Auth DB va kiem thu: AUTH_MODE=db_users
# AUTH_DATABASE_URL_FILE=D:/etl/private/auth_database_url
AUTH_DEV_ADMIN_BYPASS=false
AUTH_PUBLIC_ENABLED=false
AUTH_DEPLOYMENT_PROFILE=localhost
AUTH_COOKIE_SECURE=false
AUTH_ORIGIN=http://127.0.0.1:3000
ADMIN_LOGIN_EMAIL=YOUR_EMAIL
# ADMIN_PASSWORD_HASH_FILE=D:/etl/private/auth/admin_password_hash
# SESSION_SIGNING_KEY_FILE=D:/etl/private/auth/session_signing_key
# AUTH_PROXY_KEY_FILE=D:/etl/private/auth/auth_proxy_key
# AUTH_STATE_PATH=D:/etl/private/auth/sessions.sqlite3

# 2. POSTGRESQL MASTER DATA
# Vai trò: Lưu metadata đích, phiên bản, hàng đợi import và tiến trình OCR/ETL.
# POSTGRES_* dùng cho Docker Compose; DATABASE_URL dùng cho backend, worker và migration Master.
POSTGRES_USER=etl
POSTGRES_DB=etl
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://etl:replace-with-local-password@127.0.0.1:5432/etl

# 3. POSTGRESQL NGUỒN ERD
# Vai trò: Đọc dữ liệu nguồn; tách tài khoản reader chỉ có SELECT khỏi tài khoản owner chạy migration.
# SOURCE_FIXTURE_ROOT chỉ dùng khi SOURCE_ADAPTER=json.
# SOURCE_DATABASE_URL dùng reader; SOURCE_MIGRATION_DATABASE_URL dùng owner của DB nguồn riêng.
SOURCE_ADAPTER=json
SOURCE_FIXTURE_ROOT=./fixtures/source
SOURCE_POSTGRES_USER=etl_source_admin
SOURCE_POSTGRES_DB=etl_source
SOURCE_POSTGRES_PASSWORD=replace-with-different-source-password
SOURCE_POSTGRES_PORT=5433
SOURCE_DATABASE_URL=postgresql+psycopg://etl_source_reader:replace-with-reader-password@127.0.0.1:5433/etl_source
SOURCE_MIGRATION_DATABASE_URL=postgresql+psycopg://etl_source_admin:replace-with-different-source-password@127.0.0.1:5433/etl_source
# SOURCE on Neon: replace only SOURCE_DATABASE_URL with the readonly reader URL.
# Use sslmode=verify-full&channel_binding=require&sslrootcert=D:/etl/private/neon-ca.pem
# Keep SOURCE_POSTGRES_* for the local Docker DB only; never put Neon details there.
# Leave SOURCE_MIGRATION_DATABASE_URL unset unless an owner migration is explicitly intended.

# 4. ĐỒNG BỘ METADATA MASTER
# Vai trò: Cấu hình kích thước lô, cửa sổ đọc lại và lịch/heartbeat/lease của Master Sync worker.
# Các biến thời gian có đơn vị giây; Full/Incremental từng nhóm được lưu trong database.
SYNC_BATCH_SIZE=100
SOURCE_REPLAY_SECONDS=300
# Reconcile chỉ chạy CLI; dry-run mặc định. Apply cần fingerprint đã duyệt.
RECONCILE_MAX_AFFECTED=100
RECONCILE_MAX_RATIO=0.1
MASTER_SYNC_AUTO_INTERVAL_SECONDS=300
MASTER_SYNC_AUTO_POLL_SECONDS=5
MASTER_SYNC_AUTO_WORKER_STALE_SECONDS=30
MASTER_SYNC_AUTO_LEASE_SECONDS=120

# 5. NHẬP FILE TỪ NGUỒN LOCAL
# Vai trò: Đọc file nguồn read-only, kiểm tra hash, quản lý retry/lease và đối soát phiên bản.
# Root nguồn phải là thư mục tuyệt đối có thật; đường dẫn file là <root>/<bucket>/<object_key>.
# Nguồn không được trùng hoặc lồng với STORAGE_ROOT; trong Docker mount nguồn read-only (:ro).
SOURCE_FILE_ALLOWED_STATUSES=["APPROVED"]
# Bật theo README khi được phép đọc nguồn; không tạo bản sao SOURCE lâu dài.
SOURCE_REFERENCE_ENABLED=false
SOURCE_TEMPORARY_FILES_ENABLED=false
# SOURCE_TEMP_ROOT=D:/etl/source-temp
SOURCE_FILE_IMPORT_MAX_ATTEMPTS=3
SOURCE_FILE_IMPORT_RETRY_SECONDS=30
SOURCE_FILE_IMPORT_LEASE_SECONDS=120
SOURCE_FILE_RECONCILE_SECONDS=300
# SOURCE_FILE_STORAGE_ROOT=<duong_dan_tuyet_doi_kho_file_nguon>

# Nguồn file Google Drive tùy chọn, chạy song song Local. Không phải storage đích.
# Cài extra .[google-drive] khi bật; không lưu credential JSON trong repo.
SOURCE_DRIVE_ENABLED=false
SOURCE_DRIVE_BUCKETS={}
# canonical_id allows renames by verified Drive ID + same type; resolver still checks SHA-256.
SOURCE_DRIVE_FILENAME_POLICY=exact
# Disabled until all live revision/revocation writers are verified.
SEARCH_RESULT_SESSIONS_ENABLED=false
# Legacy exact mode only: files/<file_id>/<SOURCE filename> -> verified filename.
# Leave empty unless the actual bytes/hash have been checked for a legacy reference.
SOURCE_DRIVE_FILENAME_ALIASES={}
SOURCE_LOCAL_BUCKETS=[]
SOURCE_DRIVE_AUTH_TYPE=service_account
# SOURCE_DRIVE_CREDENTIALS_FILE=<duong_dan_tuyet_doi_ngoai_repo>/drive-reader.json
# Ví dụ cấu hình riêng ở Dev: {"COURSE_DRIVE":"folder_id_da_duoc_cap_quyen"}
# Local allowlist rỗng giữ hành vi cũ; có thể đặt ["books","COURSE_LOCAL"] để giới hạn.
# Khi tắt Drive, GIỮ bucket mapping để phiên bản Drive không bị định tuyến sang Local.
SOURCE_DRIVE_TIMEOUT_SECONDS=15
SOURCE_DRIVE_TOTAL_SECONDS=90
SOURCE_DRIVE_MAX_ATTEMPTS=3

# 6. STORAGE FILE ĐÍCH
# Vai trò: Kho ghi file LOCAL-owned và kết quả thực nghiệm; SOURCE chỉ lưu tham chiếu.
STORAGE_ROOT=./storage

# 7. OCR VÀ WORKER XỬ LÝ PDF
# Vai trò: Chọn engine, ngôn ngữ, timeout, số lần tự thử và phục hồi page task bị gián đoạn.
# native đọc text sẵn trong PDF; PDF scan cần Tesseract; fake chỉ dành cho demo/test.
OCR_ENGINE=native
TESSERACT_PATH=tesseract
TESSERACT_LANGUAGES=vie+eng

OCR_MAX_RETRIES=3
OCR_TIMEOUT_SECONDS=60
OCR_HEARTBEAT_TIMEOUT_SECONDS=120
OCR_RECOVERY_INTERVAL_SECONDS=30

# 8. CHUẨN HÓA VÀ RETRY ETL
# Vai trò: Chia nội dung thành chunk, giới hạn retry hoàn tất/projection và retry thủ công.
CHUNK_SIZE_WORDS=200
CHUNK_OVERLAP_WORDS=40
FINALIZATION_MAX_ATTEMPTS=3
FINALIZATION_RETRY_SECONDS=30
PROCESSING_MANUAL_RETRY_LIMIT=3

# 9. MONGODB NỘI DUNG
# Vai trò: Lưu projection trang OCR và các đơn vị nội dung; hoàn tất chỉ khi projection thành công.
# Host dùng cổng publish của Compose; container cùng network dùng mongodb://mongo:27017.
MONGO_PORT=27018
MONGO_URI=mongodb://127.0.0.1:27018
MONGO_DATABASE=etl_content
MONGO_METADATA_MODE=shared

# Shared: chỉ một DB etl_content; mặc định chỉ đối chiếu tại chỗ, không copy.
# Hai cờ dưới phải false; cấu hình mâu thuẫn sẽ bị chặn trước khi khởi tạo client.
SOURCE_MONGO_ENABLED=false
# Biến cũ chỉ dùng khi opt-in MONGO_METADATA_MODE=separate (ngoài kiến trúc mục tiêu).
# SOURCE_MONGO_DATABASE=source_metadata
# SOURCE_MONGO_URI=mongodb://127.0.0.1:27018
# Shared bỏ qua các URI/database nguồn cũ; không tự tạo hoặc di chuyển database.

# Shared mặc định: cả hai CLI chỉ VALIDATE_SHARED, không ghi.
# Opt-in identity-only sau Master COMMIT, chỉ Development/Test + PostgreSQL nguồn.
# Bật riêng cờ này KHÔNG bật SOURCE_MONGO_ENABLED hay legacy bootstrap.
MASTER_MONGO_IDENTITY_PROJECTION=false
# CLI project-master-mongo --full mặc định dry-run; --apply phải được duyệt riêng.
# Legacy bootstrap chỉ có thể opt-in ở mode separate; không gọi từ Master Sync/Auto.
# Bootstrap chỉ tạo identity-only, mặc định tắt. Mongo _id dùng Master.mongo_id,
# không bắt buộc trùng Master.id. Code mới cần Master head 0015, operator phải duyệt migration.
# approved_ids: danh sách ID PostgreSQL Master đã duyệt; source_verified: chỉ bản ghi
# tồn tại ở PostgreSQL nguồn và có mapping hợp lệ. SOURCE NULL chỉ fallback về PK
# khi SOURCE PG xác minh đúng ID và Master NULL/PK; LOCAL phải có mapping + approved_ids.
MASTER_MONGO_IDENTITY_BOOTSTRAP=false
MASTER_MONGO_IDENTITY_SCOPE=approved_ids
MASTER_MONGO_IDENTITY_IDS={}

# 10. BIỂU DIỄN DỮ LIỆU
# Legacy compatibility only; không còn là nguồn số chiều ContentBag/indexing.
# ContentBag store, schema CLI và model đều dùng INDEX_EMBEDDING_DIMENSION.
VECTOR_DIMENSION=256

# 10.1. CHUNK PREVIEW / CONTENTBAG DISPLAY KEYWORDS + LEXICAL BM25 + VECTOR
# Lexical dùng toàn bộ nội dung/Underthesea, không dùng top5 display keywords.
# Cần lexical schema extension/backfill: python scripts/reindex_lexical.py --dry-run
# Không cần cờ mới; không đổi model/dimension để bật BoW. Build mới vẫn cần model.
# Dense hiện giữ keyword input; ngữ nghĩa đến từ vector/Hybrid, không từ alias JSON.
# Mặc định tắt auto. Model local được provision trước; không tự tải từ Internet.
INDEX_AUTO_ENABLED=false
# Parallel BGE-M3 Chunk index; independent of legacy ContentBag vectors above.
SEMANTIC_ENABLED=false
SEMANTIC_STRATEGY=contextual
# SEMANTIC_MODEL_PATH=./Models/bge-m3
SEMANTIC_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
SEMANTIC_DEVICE=cpu
SEMANTIC_BATCH_SIZE=2
SEMANTIC_MAX_TOKENS=1024
SEMANTIC_MAX_CANDIDATES=10000
SEMANTIC_MIN_SCORE=0
SEMANTIC_RERANK_ENABLED=false
SEMANTIC_RERANK_TOP_K=20
# INDEX_EMBEDDING_MODEL_PATH=D:/Models/multilingual-embedding
INDEX_EMBEDDING_MODEL_ID=
INDEX_EMBEDDING_MODEL_VERSION=
INDEX_EMBEDDING_DIMENSION=384
# BGE-M3 alternative (change existing values above, do not duplicate keys):
# INDEX_EMBEDDING_MODEL_PATH=D:/etl/models/bge-m3
# INDEX_EMBEDDING_MODEL_ID=BAAI/bge-m3
# INDEX_EMBEDDING_MODEL_VERSION=5617a9f61b028005a4858fdac845db406aefb181
# INDEX_EMBEDDING_DIMENSION=1024
# Keep INDEX_AUTO_ENABLED=false until the vector schema/index transition is approved.
# Only after an approved transition retaining inactive vectors:
# INDEX_HISTORICAL_EMBEDDING_DIMENSIONS=[384]
# Automatic multilingual meaning groups from observed source text (requires meaning schema + reindex).
# false keeps keyword vectors; reviewed concept expansion remains independent.
INDEX_MEANING_BAGS_ENABLED=true
INDEX_MEANING_GROUP_THRESHOLD=0.8
INDEX_MAX_CHUNKS=10000
INDEX_MAX_UNITS=10000
INDEX_MAX_SOURCE_CHARS=10000000
INDEX_TIMEOUT_SECONDS=300

# LOCAL_DEMO: chỉ dữ liệu thử nghiệm được phép dùng trên máy Dev cô lập.
# Tái sử dụng cờ hiện có; không phải quyền công khai hoặc đăng nhập.
# Cần ADMIN_ENABLED=true, Development, Uvicorn bind loopback và --no-proxy-headers.
# Không dùng sau proxy public/container; Public mặc định chặn khi chưa có bằng chứng quyền.
# APP_ENVIRONMENT=development
SEARCH_INTERNAL_DEV_ENABLED=false
SEARCH_TIMEOUT_SECONDS=15
# Cosine admission gate applied to Vector before Hybrid RRF; tune on labelled queries.
# A cosine score is not a probability. Raising this can reduce multilingual recall.
SEARCH_VECTOR_MIN_SIMILARITY=0.6
# Subthreshold Vector hits need a verified source phrase; raw dense score stays mandatory.
SEARCH_VECTOR_ANCHOR_FALLBACK_ENABLED=true
SEARCH_VECTOR_ANCHOR_MIN_SIMILARITY=0.4
# Optional same-bag dense corroboration for multilingual Meaning Bag near misses.
# Tune on your corpus; leaves the strict primary gate and BoW independent.
SEARCH_MEANING_CONTEXT_FALLBACK_ENABLED=false
SEARCH_MEANING_FALLBACK_MIN_SIMILARITY=0.55
SEARCH_MEANING_FALLBACK_MIN_CONTEXT_SIMILARITY=0.45
# Max cosine gap for selecting a better supported source span; 0 keeps raw max.
SEARCH_MEANING_CONTEXT_MARGIN=0.08
# Minimum fraction of informative words/concepts matched by BoW; 0 disables.
SEARCH_BOW_MIN_COVERAGE=0
# Experimental; keep bag until paired quality and authenticated API acceptance.
SEARCH_HYBRID_FUSION_UNIT=bag
SEARCH_APPROVED_ACCENT_VARIANTS_ENABLED=false
SEARCH_CORPUS_ACCENT_CANDIDATES_ENABLED=false
# Independent MASTER metadata index; schema must be provisioned explicitly.
SEARCH_METADATA_ENABLED=false
SEARCH_METADATA_INDEXED_CANDIDATES_ENABLED=false
SEARCH_METADATA_AUTHORITY_LIMIT=10000
SEARCH_METADATA_MATCH_LIMIT=2000
SEARCH_METADATA_CONTENT_ENABLED=true
SOURCE_METADATA_MEDIA_ENABLED=false
# Existing Master Sync Worker sweeps committed metadata, opt-in; no OCR.
SEARCH_METADATA_AUTO_REFRESH_ENABLED=false
SEARCH_METADATA_REFRESH_DENSE=false
SEARCH_METADATA_REFRESH_CONTENT_SEMANTIC=false
SEMANTIC_INPUT_IDENTITY_ENABLED=false
SEARCH_METADATA_REFRESH_BATCH_SIZE=5
SEARCH_METADATA_REFRESH_INTERVAL_SECONDS=30
# Experimental only. Non-unit weights require version fusion; keep defaults.
SEARCH_HYBRID_LEXICAL_WEIGHT=1.0
SEARCH_HYBRID_VECTOR_WEIGHT=1.0
# Experimental evidence additionally requires Semantic Chunk index + ColBERT OFF.
SEARCH_EVIDENCE_STRATEGY=current
SEARCH_EVIDENCE_TOP_N=3
SEARCH_EVIDENCE_DENSE_MARGIN=0.08
SEARCH_MODEL_WARMUP_TIMEOUT_SECONDS=60

# Thực nghiệm: file JSON dưới STORAGE_ROOT/evaluations, cần quyền truy cập hợp lệ.
EVALUATION_MAX_QUERIES=20
EVALUATION_MAX_CORPUS_VERSIONS=100
EVALUATION_MAX_STORED_FILES=200
EVALUATION_MAX_FILE_BYTES=8388608
EVALUATION_RUN_TIMEOUT_SECONDS=300

# 11. DATABASE KIỂM THỬ RIÊNG
# Vai trò: Chỉ dành cho test PostgreSQL/MongoDB cô lập, không trỏ vào database dữ liệu thật.
# TEST_DATABASE_URL=postgresql+psycopg://etl:replace-with-local-password@127.0.0.1:5432/etl_test
# TEST_SOURCE_DATABASE_URL=postgresql+psycopg://etl_source_admin:replace-with-different-source-password@127.0.0.1:5433/etl_source_test
# TEST_MONGO_URI=mongodb://127.0.0.1:27018

# Optional MASTER user login + configured admin (no Auth DB migration).
# AUTH_MODE=master_users
# AUTH_MASTER_FRESHNESS_SECONDS=120
# AUTH_MASTER_PBKDF2_SALT_ENCODING=auto
# Legacy setting, ignored for MASTER resource access (created_by ownership only):
# AUTH_MASTER_RESOURCE_GRANTS={}

# Reviewed concept expansion; optional JSON snapshot override (loaded at startup).
# SEARCH_EXPANSION={"enabled":true,"synonyms":0.8,"translations":0.65,"max_per_concept":12,"max_total":64,"max_depth":1,"allowed_relations":["equivalent","translation"]}

# Dynamic corpus dictionary: offline implementation only; live gates NOT verified.
# Flags alone never grant read-only credentials, public rights or release approval.
CONCEPT_DYNAMIC_ENABLED=false
CONCEPT_DYNAMIC_BUILDER_ENABLED=false
CONCEPT_DISCOVERY_SEMANTIC_ENABLED=false
# CONCEPT_DYNAMIC_ARTIFACT_ROOT=/absolute/private/derived/concepts
# CONCEPT_CORPUS_MONGO_URI_FILE=/absolute/private/secrets/corpus_mongo_uri
CONCEPT_DYNAMIC_LOOKUP_BUDGET_MS=20
CONCEPT_DYNAMIC_CACHE_MAX_MB=16
CONCEPT_DYNAMIC_REFRESH_INTERVAL_SECONDS=10
CONCEPT_DYNAMIC_MAX_LOOKUP_RECORDS=32
CONCEPT_BUILDER_BATCH_SIZE=20
CONCEPT_BUILDER_TICK_SECONDS=2
CONCEPT_BUILDER_MAX_CANDIDATES=64
CONCEPT_BUILDER_MAX_CHARS=100000
CONCEPT_ARTIFACT_SHARDS=4
CONCEPT_ARTIFACT_MAX_MB=512
# Local multimedia and linked translations. No runtime downloads or remote APIs.
# Legacy true means automatic SOURCE ingestion registers media metadata only.
# SOURCE_METADATA_MEDIA_ENABLED is configured in the SOURCE section above.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_MAX_SIZE_BYTES=52428800
MEDIA_MAX_DURATION_SECONDS=1800
MEDIA_TIMEOUT_SECONDS=900
MEDIA_CPU_THREADS=4
MEDIA_MAX_CONCURRENCY=1
# Frame/OCR limits apply only to MP4 without an audio track.
MEDIA_FRAME_INTERVAL_SECONDS=4
MEDIA_MAX_FRAMES=120
MEDIA_FRAME_WIDTH=1280
MEDIA_SCENE_DETECTION=true
MEDIA_SCENE_THRESHOLD=0.35
MEDIA_MAX_SEGMENTS=5000
# Install the full multilingual large-v3 first; unset path safely disables ASR.
# WHISPER_MODEL_PATH=Models/faster-whisper-large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
ASR_WINDOW_SECONDS=15
TRANSLATION_PROVIDER=argos
# Directory containing extracted Argos packages (each has metadata.json/model/).
# TRANSLATION_MODEL_ROOT=D:/etl/models/argos
TRANSLATION_TARGET_LANGUAGE=vi
TRANSLATION_TIMEOUT_SECONDS=60
TRANSLATION_JOB_TIMEOUT_SECONDS=600
TRANSLATION_MAX_RETRIES=3

# Independent read-only reconciliation worker (OFF until explicitly enabled).
RECONCILIATION_SCHEDULER_ENABLED=false
# Optional independent worker health file; never reuse the Sync heartbeat path.
# RECONCILIATION_WORKER_HEARTBEAT_FILE=D:/etl/private/audit-heartbeat.json
RECONCILIATION_LIGHT_INTERVAL_SECONDS=3600
RECONCILIATION_ID_SWEEP_INTERVAL_SECONDS=604800
RECONCILIATION_DEEP_COVERAGE_DAYS=30
RECONCILIATION_AUDIT_BATCH_SIZE=100
RECONCILIATION_MAX_FILES_PER_RUN=100
RECONCILIATION_MAX_BYTES_PER_RUN=2147483648
RECONCILIATION_MAX_SECONDS_PER_RUN=1800
RECONCILIATION_FILE_TIMEOUT_SECONDS=120
RECONCILIATION_LEASE_SECONDS=60
RECONCILIATION_RETRY_MAX_ATTEMPTS=3
RECONCILIATION_RETRY_SECONDS=30
