# Add these NON-SECRET settings to your external app.env, alongside Docker settings.
AUTH_MODE=single_admin
AUTH_APP_ENVIRONMENT=production
ADMIN_ENABLED=true
AUTH_DEV_ADMIN_BYPASS=false
AUTH_PUBLIC_ENABLED=false
AUTH_DEPLOYMENT_PROFILE=localhost
AUTH_COOKIE_SECURE=false
AUTH_ORIGIN=http://127.0.0.1:8080
ADMIN_LOGIN_EMAIL=SET_YOUR_ADMIN_EMAIL
ADMIN_PASSWORD_HASH_SECRET_FILE=/absolute/private/auth/admin_password_hash
SESSION_SIGNING_KEY_SECRET_FILE=/absolute/private/auth/session_signing_key
AUTH_PROXY_KEY_SECRET_FILE=/absolute/private/auth/auth_proxy_key
# LOCAL DEMO ONLY: AUTH_MODE=local_demo, AUTH_APP_ENVIRONMENT=local,
# AUTH_DEV_ADMIN_BYPASS=true. Keep localhost profile and public=false.
# LAN TLS: select auth-tls overlay; AUTH_ORIGIN=https://etl.example.edu:8443,
# AUTH_PUBLIC_ENABLED=true, AUTH_DEPLOYMENT_PROFILE=multi_machine,
# AUTH_COOKIE_SECURE=true. Approved cert/key must be readable by UID101.
# AUTH_TLS_CERT_FILE=/absolute/private/tls/server.crt
# AUTH_TLS_KEY_FILE=/absolute/private/tls/server.key
# AUTH_BIND_IP=0.0.0.0
# WEB_TLS_PORT=8443
