# Copy to docker.env at the repository root; ignored by Git and Docker build.
# This file contains paths, never credentials.
APP_PROJECT=etl-app
BACKEND_IMAGE=etl-portable-backend:local
# ETL_MANAGED object storage (private, S3-compatible).  The same application
# code supports Neon Object Storage, Cloudflare R2, AWS S3 and Supabase S3.
ETL_FILE_STORAGE_MODE=object
ETL_FILE_STORAGE_PROVIDER=neon
ETL_FILE_STORAGE_ENDPOINT_URL=https://object-storage.example.invalid
ETL_FILE_STORAGE_REGION=us-east-1
ETL_FILE_STORAGE_BUCKET=etl-learning-resources
ETL_FILE_STORAGE_PROVIDER_ID=etl-cloud-current
ETL_FILE_STORAGE_FORCE_PATH_STYLE=true
ETL_FILE_STORAGE_SIGNATURE_VERSION=s3v4
ETL_FILE_STORAGE_PRIVATE=true
ETL_FILE_STORAGE_READ_URL_TTL_SECONDS=60
ETL_FILE_STORAGE_UPLOAD_URL_TTL_SECONDS=300
ETL_FILE_STORAGE_MAX_UPLOAD_BYTES=536870912
ETL_FILE_STORAGE_CONNECT_TIMEOUT_SECONDS=10
ETL_FILE_STORAGE_READ_TIMEOUT_SECONDS=60
ETL_FILE_STORAGE_OBJECT_PREFIX=learning-resources/
# Mount these as Docker secrets; do not put values in docker.env:
# ETL_FILE_STORAGE_ACCESS_KEY_ID_FILE=/run/secrets/file_storage_access_key
# ETL_FILE_STORAGE_SECRET_ACCESS_KEY_FILE=/run/secrets/file_storage_secret_key
# ETL_FILE_STORAGE_LEGACY_READ_REGISTRY_FILE=/run/secrets/legacy-storage-providers.json
## Parallel BGE-M3 chunk index (opt-in; keep false until backfill verifies READY).
INSTALL_SEMANTIC=false
INSTALL_MEDIA=false
SEMANTIC_ENABLED=false
SEMANTIC_STRATEGY=contextual
SEMANTIC_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
SEMANTIC_BATCH_SIZE=2
SEMANTIC_MAX_TOKENS=1024
SEMANTIC_MAX_CANDIDATES=10000
SEMANTIC_MIN_SCORE=0
# SEMANTIC_MODEL_DIR=D:/etl/models/bge-m3  # Defaults to MODEL_DIR when omitted.
SEMANTIC_RERANK_ENABLED=false
SEMANTIC_RERANK_TOP_K=20
FRONTEND_IMAGE=etl-portable-frontend:local
ETL_DATA_NETWORK=etl-data
WEB_PORT=8080
# Use absolute Windows C:/... or Linux /home/... paths on EACH machine.
MODEL_DIR=D:/etl/models/bge-m3
MODEL_MANIFEST_FILE=D:/etl/models/bge-m3/etl-model-manifest.json
# Recommended fresh installation: BGE-M3 dense 1024D, matching README.
# Fresh SOURCE/MASTER/Atlas installations use the real 1024D BGE-M3 contract.
INDEX_EMBEDDING_MODEL_ID=BAAI/bge-m3
INDEX_EMBEDDING_MODEL_VERSION=5617a9f61b028005a4858fdac845db406aefb181
INDEX_EMBEDDING_DIMENSION=1024
# Keep INDEX_AUTO_ENABLED=false until Atlas validators and indexes are verified.
INDEX_HISTORICAL_EMBEDDING_DIMENSIONS=[]
# Existing MiniLM data requires an explicit, reviewed migration before changing dimensions.
SOURCE_LOCAL_DIR=D:/etl/source
CONNECTIONS_FILE=D:/etl/private/connections.json
DATABASE_MODE=same-host
# Remote database overlay only (DNS/TLS endpoints provisioned by DBA):
# DATABASE_MODE=remote
# DATABASE_CA_FILE=/absolute/private/database-ca.pem
# SOURCE on Neon, MASTER/Mongo on local Docker services:
# scripts select compose.source-neon.yml automatically from DATABASE_MODE.
# DATABASE_MODE=source-neon
# SOURCE_DATABASE_CA_FILE=/absolute/private/neon-ca.pem
# SOURCE URL: sslmode=verify-full&channel_binding=require&sslrootcert=/run/secrets/source-database-ca.pem
# Optional SOURCE Neon Object Storage reader. The actual object must match
# SOURCE resource_versions.storage_bucket + storage_object_key exactly.
# SOURCE_FILE_STORAGE_MODE=object
# SOURCE_FILE_STORAGE_PROVIDER=neon
# SOURCE_FILE_STORAGE_ENDPOINT_URL=https://object-storage.example.invalid
# SOURCE_FILE_STORAGE_REGION=us-east-1
# SOURCE_FILE_STORAGE_BUCKET=assets
# SOURCE_FILE_STORAGE_PROVIDER_ID=source-cloud-current
# SOURCE_FILE_STORAGE_FORCE_PATH_STYLE=true
# SOURCE_FILE_STORAGE_SIGNATURE_VERSION=s3v4
# SOURCE_FILE_STORAGE_READ_URL_TTL_SECONDS=60
# SOURCE_FILE_STORAGE_ACCESS_KEY_ID_FILE=/run/secrets/source_file_storage_access_key
# SOURCE_FILE_STORAGE_SECRET_ACCESS_KEY_FILE=/run/secrets/source_file_storage_secret_key
# Both must be explicitly approved/enabled to process SOURCE files; no copier fallback.
SOURCE_REFERENCE_ENABLED=false
SOURCE_TEMPORARY_FILES_ENABLED=false
SOURCE_METADATA_WRITEBACK_ENABLED=false
SOURCE_METADATA_WRITER_MODE=disabled
SOURCE_WRITE_ALLOWED_ACTIONS=["update"]
# The separate SOURCE role is etl_source_writer. Inject its complete DSN as a
# Docker secret; do not place the password in docker.env or the image.
SOURCE_WRITE_DATABASE_URL_FILE=/run/secrets/source-write-database-url
SOURCE_WRITE_CONTRACT_FILE=/run/secrets/source-write-contract.json
# Host-side files consumed by compose.source-write.override.example.yml:
# SOURCE_WRITE_DATABASE_URL_SECRET_HOST_FILE=D:/etl/private/source-write-database-url
# SOURCE_WRITE_CONTRACT_SECRET_HOST_FILE=D:/etl/private/source-write-contract.json
SOURCE_WRITE_CONNECT_TIMEOUT_SECONDS=10
SOURCE_WRITE_STATEMENT_TIMEOUT_SECONDS=30
SOURCE_WRITE_LOCK_TIMEOUT_SECONDS=5
# Keep CREATE_VERSION/cloud upload disabled until SOURCE owner approval.
SOURCE_VERSION_WRITEBACK_ENABLED=false
# SOURCE_VERSION_WRITE_CONTRACT_FILE=/run/secrets/source-version-write-contract.json
SOURCE_VERSION_WRITE_ALLOWED_ACTIONS=["create"]
SOURCE_STORAGE_WRITE_ENABLED=false
# SOURCE_STORAGE_WRITE_CONTRACT_FILE=/run/secrets/source-object-storage-write-contract.json
# SOURCE_STORAGE_WRITE_ENDPOINT_URL=https://object-storage.example.invalid
# SOURCE_STORAGE_WRITE_REGION=us-east-1
# SOURCE_STORAGE_WRITE_BUCKET=source-uploads
SOURCE_STORAGE_WRITE_PROVIDER=neon
SOURCE_STORAGE_WRITE_PROVIDER_ID=source-cloud-current
# SOURCE_STORAGE_WRITE_ACCESS_KEY_ID_FILE=/run/secrets/source-storage-write-access-key
# SOURCE_STORAGE_WRITE_SECRET_ACCESS_KEY_FILE=/run/secrets/source-storage-write-secret-key
# Global queue admission (validated 1..2). Keep 1 until benchmarked locally.
SOURCE_FILE_IMPORT_MAX_ACTIVE=1
RECONCILIATION_MAX_ACTIVE=1
# Per-container limits; container tmpfs/OS locks do not provide a fleet-wide permit.
SOURCE_TEMP_MAX_CONCURRENCY=4
MEDIA_CPU_THREADS=4
MEDIA_MAX_CONCURRENCY=1
INDEX_AUTO_ENABLED=false
MASTER_SYNC_AUTO_INTERVAL_SECONDS=30
SEARCH_MODEL_WARMUP_TIMEOUT_SECONDS=120
SEARCH_VECTOR_MIN_SIMILARITY=0.6
SEARCH_VECTOR_ANCHOR_FALLBACK_ENABLED=true
SEARCH_VECTOR_ANCHOR_MIN_SIMILARITY=0.4
# Opt-in only after local evaluation; original query + one approved phrase variant.
SEARCH_APPROVED_ACCENT_VARIANTS_ENABLED=false
SEARCH_CORPUS_ACCENT_CANDIDATES_ENABLED=false
SEARCH_METADATA_ENABLED=false
SEARCH_METADATA_INDEXED_CANDIDATES_ENABLED=false
SEARCH_METADATA_AUTHORITY_LIMIT=10000
SEARCH_METADATA_MATCH_LIMIT=2000
SEARCH_METADATA_CONTENT_ENABLED=true
SOURCE_METADATA_MEDIA_ENABLED=false
SOURCE_DRIVE_FILENAME_POLICY=exact
# Enable only with a complete local faster-whisper model and rebuild backend.
SEARCH_RESULT_SESSIONS_ENABLED=false
MEDIA_ENABLED=false
WHISPER_MODEL_DIR=./Models/faster-whisper-large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SEARCH_METADATA_AUTO_REFRESH_ENABLED=false
SEARCH_METADATA_REFRESH_DENSE=false
SEARCH_METADATA_REFRESH_CONTENT_SEMANTIC=false
SEMANTIC_INPUT_IDENTITY_ENABLED=false
SEARCH_METADATA_REFRESH_BATCH_SIZE=5
SEARCH_METADATA_REFRESH_INTERVAL_SECONDS=30
SEARCH_MEANING_CONTEXT_FALLBACK_ENABLED=false
SEARCH_MEANING_FALLBACK_MIN_SIMILARITY=0.55
SEARCH_MEANING_FALLBACK_MIN_CONTEXT_SIMILARITY=0.45
SEARCH_MEANING_CONTEXT_MARGIN=0.08
SEARCH_BOW_MIN_COVERAGE=0
API_MEMORY_LIMIT=3g
OCR_MEMORY_LIMIT=3g
API_CPUS=2
OCR_CPUS=2
# Separate database project; no startup migration/bootstrap.
DB_PROJECT=etl-databases
MASTER_DB_NAME=etl_master
SOURCE_DB_NAME=etl_source
MASTER_DB_ADMIN=etl_master_owner
SOURCE_DB_ADMIN=etl_source_owner
MONGO_DB_ADMIN=etl_mongo_owner
MASTER_PASSWORD_FILE=./private/master-password
MASTER_ONLY_PROJECT=etl-master-only
MASTER_ONLY_PORT=5434
SOURCE_PASSWORD_FILE=./private/source-password
MONGO_PASSWORD_FILE=./private/mongo-password
# Optional compose.drive.yml (do not enable without source access approval):
# DRIVE_CREDENTIALS_FILE=/absolute/private/drive.json
# SOURCE_DRIVE_BUCKETS={"DRIVE":"approved-folder-id"}
# SOURCE_LOCAL_BUCKETS=[]
# SOURCE_DRIVE_AUTH_TYPE=service_account
# Grant source processing per registered source only after confirming read/OCR/index rights.
# Example: [{"source_id":"SRC_DEFAULT","backend":"postgresql","namespace":"postgresql:learning","adapter_type":"PostgreSQLSourceAdapter","enabled":true,"capabilities":{"read_metadata":true,"read_content":true,"process_content":true,"index_derived_content":true,"exact_resource_lookup":true,"exact_version_lookup":true,"file_reference_lookup":true,"external_viewer":true,"remote_search":false,"write_metadata":false},"viewer_hosts":["drive.google.com","docs.google.com"]}]
# SOURCE_REGISTRY_CONFIG='[{...}]'
# Owner maintenance only, never passed to app runtime:
# OPS_CONNECTIONS_FILE=/absolute/private/ops-connections.json
# ETL_MAINTENANCE_APPROVAL=NOT_APPROVED

# Authentication: fill the secret FILE paths; never paste secret contents here.
AUTH_MODE=single_admin
# Database auth: select launcher profile db-auth (or db-auth-tls), AUTH_MODE=db_users.
# AUTH_DATABASE_URL_SECRET_FILE=/absolute/private/auth_database_url
# See deploy/AUTH_DATABASE_SETUP.md; no automatic migration or bootstrap.
AUTH_APP_ENVIRONMENT=production
ADMIN_ENABLED=true
AUTH_DEV_ADMIN_BYPASS=false
AUTH_PUBLIC_ENABLED=false
AUTH_DEPLOYMENT_PROFILE=localhost
AUTH_COOKIE_SECURE=false
AUTH_ORIGIN=http://127.0.0.1:8080
ADMIN_LOGIN_EMAIL=SET_YOUR_ADMIN_EMAIL
ADMIN_PASSWORD_HASH_SECRET_FILE=D:/etl/private/auth/admin_password_hash
SESSION_SIGNING_KEY_SECRET_FILE=D:/etl/private/auth/session_signing_key
AUTH_PROXY_KEY_SECRET_FILE=D:/etl/private/auth/auth_proxy_key
# LOCAL DEMO ONLY: AUTH_MODE=local_demo, AUTH_APP_ENVIRONMENT=local,
# AUTH_DEV_ADMIN_BYPASS=true. Keep localhost profile and public=false.
# LAN TLS: select auth-tls overlay; AUTH_ORIGIN=https://etl.example.edu:8443,
# AUTH_PUBLIC_ENABLED=true, AUTH_DEPLOYMENT_PROFILE=multi_machine,
# AUTH_COOKIE_SECURE=true. Approved cert/key must be readable by UID101.
# AUTH_TLS_CERT_FILE=/absolute/private/tls/server.crt
# AUTH_TLS_KEY_FILE=/absolute/private/tls/server.key
# AUTH_BIND_IP=0.0.0.0
# WEB_TLS_PORT=8443

# MASTER identity + configured admin, keep profile auth, not db-auth:
# AUTH_MODE=master_users
# AUTH_MASTER_FRESHNESS_SECONDS=120
# AUTH_MASTER_PBKDF2_SALT_ENCODING=auto
# Legacy setting, ignored for MASTER resource access (created_by ownership only):
# AUTH_MASTER_RESOURCE_GRANTS={}

# Corpus dictionary remains OFF: live RO/revocation/artifact gates unverified.
CONCEPT_DYNAMIC_ENABLED=false
CONCEPT_DYNAMIC_BUILDER_ENABLED=false
CONCEPT_DISCOVERY_SEMANTIC_ENABLED=false
CONCEPT_DYNAMIC_LOOKUP_BUDGET_MS=20
CONCEPT_DYNAMIC_CACHE_MAX_MB=16
CONCEPT_DYNAMIC_REFRESH_INTERVAL_SECONDS=10
# No live concept volume or secret is provisioned by this template.

# Optional legacy fixed audit schedules; admin UI schedules are stored in MASTER.
RECONCILIATION_SCHEDULER_ENABLED=false
RECONCILIATION_MAX_FILES_PER_RUN=100
RECONCILIATION_MAX_BYTES_PER_RUN=2147483648
RECONCILIATION_MAX_SECONDS_PER_RUN=1800
RECONCILIATION_FILE_TIMEOUT_SECONDS=120
