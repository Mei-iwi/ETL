# Copy to docker.env at the repository root; ignored by Git and Docker build.
# This file contains paths, never credentials.
APP_PROJECT=etl-app
BACKEND_IMAGE=etl-portable-backend:local
FRONTEND_IMAGE=etl-portable-frontend:local
ETL_DATA_NETWORK=etl-data
WEB_PORT=8080
# Use absolute Windows C:/... or Linux /home/... paths on EACH machine.
MODEL_DIR=./model
MODEL_MANIFEST_FILE=./model/etl-model-manifest.json
# Model identity must match the mounted manifest. Default remains MiniLM.
INDEX_EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INDEX_EMBEDDING_MODEL_VERSION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
INDEX_EMBEDDING_DIMENSION=384
# BGE-M3: change the three values above to BAAI/bge-m3, the pinned revision,
# and 1024; set MODEL_DIR/MODEL_MANIFEST_FILE to the prepared BGE directory.
# Keep INDEX_AUTO_ENABLED=false until Mongo validators and indexes are migrated.
INDEX_HISTORICAL_EMBEDDING_DIMENSIONS=[]
# Existing MiniLM data: use [384] after the reviewed local transition procedure.
SOURCE_LOCAL_DIR=./source-empty
CONNECTIONS_FILE=./config/connections.example.json
DATABASE_MODE=same-host
# Remote database overlay only (DNS/TLS endpoints provisioned by DBA):
# DATABASE_MODE=remote
# DATABASE_CA_FILE=/absolute/private/database-ca.pem
# SOURCE on Neon, MASTER/Mongo on local Docker services:
# scripts select compose.source-neon.yml automatically from DATABASE_MODE.
# DATABASE_MODE=source-neon
# SOURCE_DATABASE_CA_FILE=/absolute/private/neon-ca.pem
# SOURCE URL: sslmode=verify-full&channel_binding=require&sslrootcert=/run/secrets/source-database-ca.pem
# Both must be explicitly approved/enabled to process SOURCE files; no copier fallback.
SOURCE_REFERENCE_ENABLED=false
SOURCE_TEMPORARY_FILES_ENABLED=false
INDEX_AUTO_ENABLED=false
MASTER_SYNC_AUTO_INTERVAL_SECONDS=30
SEARCH_MODEL_WARMUP_TIMEOUT_SECONDS=120
API_MEMORY_LIMIT=3g
OCR_MEMORY_LIMIT=3g
API_CPUS=2
OCR_CPUS=2
# Separate database project; no startup migration/bootstrap.
DB_PROJECT=etl-databases
MASTER_DB_NAME=etl_master
SOURCE_DB_NAME=etl_source
MASTER_DB_ADMIN=etl_master_owner
SOURCE_DB_ADMIN=etl_source_owner
MONGO_DB_ADMIN=etl_mongo_owner
MASTER_PASSWORD_FILE=./private/master-password
SOURCE_PASSWORD_FILE=./private/source-password
MONGO_PASSWORD_FILE=./private/mongo-password
# Optional compose.drive.yml (do not enable without source access approval):
# DRIVE_CREDENTIALS_FILE=/absolute/private/drive.json
# SOURCE_DRIVE_BUCKETS={"DRIVE":"approved-folder-id"}
# SOURCE_LOCAL_BUCKETS=[]
# SOURCE_DRIVE_AUTH_TYPE=service_account
# Owner maintenance only, never passed to app runtime:
# OPS_CONNECTIONS_FILE=/absolute/private/ops-connections.json
# ETL_MAINTENANCE_APPROVAL=NOT_APPROVED

# Authentication: fill the secret FILE paths; never paste secret contents here.
AUTH_MODE=single_admin
# Database auth: select launcher profile db-auth (or db-auth-tls), AUTH_MODE=db_users.
# AUTH_DATABASE_URL_SECRET_FILE=/absolute/private/auth_database_url
# See deploy/AUTH_DATABASE_SETUP.md; no automatic migration or bootstrap.
AUTH_APP_ENVIRONMENT=production
ADMIN_ENABLED=true
AUTH_DEV_ADMIN_BYPASS=false
AUTH_PUBLIC_ENABLED=false
AUTH_DEPLOYMENT_PROFILE=localhost
AUTH_COOKIE_SECURE=false
AUTH_ORIGIN=http://127.0.0.1:8080
ADMIN_LOGIN_EMAIL=SET_YOUR_ADMIN_EMAIL
ADMIN_PASSWORD_HASH_SECRET_FILE=/absolute/private/auth/admin_password_hash
SESSION_SIGNING_KEY_SECRET_FILE=/absolute/private/auth/session_signing_key
AUTH_PROXY_KEY_SECRET_FILE=/absolute/private/auth/auth_proxy_key
# LOCAL DEMO ONLY: AUTH_MODE=local_demo, AUTH_APP_ENVIRONMENT=local,
# AUTH_DEV_ADMIN_BYPASS=true. Keep localhost profile and public=false.
# LAN TLS: select auth-tls overlay; AUTH_ORIGIN=https://etl.example.edu:8443,
# AUTH_PUBLIC_ENABLED=true, AUTH_DEPLOYMENT_PROFILE=multi_machine,
# AUTH_COOKIE_SECURE=true. Approved cert/key must be readable by UID101.
# AUTH_TLS_CERT_FILE=/absolute/private/tls/server.crt
# AUTH_TLS_KEY_FILE=/absolute/private/tls/server.key
# AUTH_BIND_IP=0.0.0.0
# WEB_TLS_PORT=8443

# MASTER identity + configured admin, keep profile auth, not db-auth:
# AUTH_MODE=master_users
# AUTH_MASTER_FRESHNESS_SECONDS=120
# AUTH_MASTER_PBKDF2_SALT_ENCODING=auto
# Legacy setting, ignored for MASTER resource access (created_by ownership only):
# AUTH_MASTER_RESOURCE_GRANTS={}
